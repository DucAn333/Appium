# Copy to .env. Run adb devices to find DEVICE_UDID.
DEVICE_NAME=Android
# Project emulator started by npm run android uses port 5556.
DEVICE_UDID=emulator-5556

# Optional APK path. If omitted, the smoke test opens Android Settings.
# APP_PATH=./apps/app.apk
# APP_PACKAGE=com.android.settings
# APP_ACTIVITY=.Settings
